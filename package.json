{
  "name": "@lynse.ai/lynse-cli",
  "version": "1.8.2",
  "description": "灵光记 / Lynse CLI 技能包 - 调用 lynse.ai 后端服务的 API，支持用户管理、文件管理、转写总结、待办整理、设备管理等功能。跨平台支持 Windows/macOS/Linux。",
  "main": "lynse.py",
  "bin": {
    "lynse": "./bin/lynse.js"
  },
  "scripts": {
    "pack:skill": "python3 scripts/build_skill_package.py",
    "test": "python3 -m unittest discover -v"
  },
  "keywords": [
    "lynse",
    "灵光记",
    "cli",
    "ai",
    "transcription",
    "todos",
    "tasks",
    "api-wrapper",
    "openclaw",
    "cross-platform",
    "windows"
  ],
  "author": "lynse.ai",
  "license": "MIT",
  "homepage": "https://www.lynse.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynse-ai/lynse-cli.git"
  },
  "bugs": {
    "url": "https://github.com/lynse-ai/lynse-cli/issues"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "lynse.py",
    "pyproject.toml",
    "bin/lynse.js",
    "scripts/build_skill_package.py",
    "requirements.txt",
    "README.md",
    "SKILL.md",
    "references/",
    "CHANGELOG.md"
  ],
  "engines": {
    "python": ">=3.11"
  }
}
